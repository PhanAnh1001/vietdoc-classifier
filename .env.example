# VietDoc Classifier — Environment Variables
# Copy to .env and fill in values

# Database (PostgreSQL on AWS Lightsail)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/vietdoc

# Security
SECRET_KEY=change-me-to-a-random-32-char-string

# Redis (AWS Lightsail)
REDIS_URL=redis://localhost:6379

# Next.js frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Groq AI (required for OCR + classification)
# Get free key at: https://console.groq.com
GROQ_API_KEY=gsk_...

# Production (AWS Lightsail)
LIGHTSAIL_HOST=
LIGHTSAIL_SSH_KEY=
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
